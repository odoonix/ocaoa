<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_inherit_bom_item" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.bom.item</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_mrp_bom.sale_order_form" />
        <field name="arch" type="xml">

            <xpath
                expr="//field[@name='order_line']//list//field[@name='bom_id']"
                position="attributes"
            >
                <attribute name="string">Item</attribute>
            </xpath>

        </field>
    </record>
</odoo>