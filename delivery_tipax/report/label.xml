<odoo>
    <record id="action_tipax_label" model="ir.actions.report">
        <field name="name">Tipax Internal Parcel Label (not official)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">delivery_tipax.internal_label</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
    </record>
    <template id="internal_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Internal parcel label — not official Tipax label</h2>
                        <p t-field="o.name" />
                        <p t-field="o.carrier_tracking_ref" />
                        <p t-field="o.tipax_direction" />
                        <p t-field="o.partner_id" />
                        <p t-field="o.tipax_status" />
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>